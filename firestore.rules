rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User document — single blob pattern (migrate to subcollections in future)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data is map;

      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data is map
                    && request.resource.data.keys().hasAll(["updatedAt"]);

      allow delete: if false; // disallow document deletion
    }

    // Future subcollections pattern
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
