# Get your Anthropic API key at https://console.anthropic.com/
# Set a real key to enable AI coaching (mock responses used otherwise)
VITE_ANTHROPIC_API_KEY=

# Get your USDA API key at https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=

# Firebase config (from Firebase Console → Project Settings → General → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
