# Get your Anthropic API key at https://console.anthropic.com/
# Set a real key to enable AI coaching (mock responses used otherwise)
VITE_ANTHROPIC_API_KEY=

# Get your USDA API key at https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=

# ── Firebase (REQUIRED for auth + cloud sync) ───────────────────────────────
# All 6 VITE_FIREBASE_* variables below are REQUIRED for Google/email sign-in
# and Firestore sync. Copy the full web app config from:
#   Firebase Console → Project Settings → General → Your apps → Web app → Config
# Set the SAME values in Vercel (Project → Settings → Environment Variables)
# or Firebase won't initialize in production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only used for Analytics. Not read by the app code; omit unless you add Analytics.
VITE_FIREBASE_MEASUREMENT_ID=
